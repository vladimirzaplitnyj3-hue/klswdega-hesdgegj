# ========== ФУНКЦИИ ==========

def send_message(chat_id, text, reply_markup=None, parse_mode="HTML"):
    url = f"{BASE_URL}/sendMessage"
    payload = {"chat_id": chat_id, "text": text, "parse_mode": parse_mode}
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if result.get("ok"):
            logger.info(f"✅ Сообщение отправлено в {chat_id}")
        else:
            logger.error(f"❌ Ошибка send_message: {result}")
        return result
    except Exception as e:
        logger.error(f"💥 Ошибка send_message: {e}")
        logger.error(traceback.format_exc())
        return {"ok": False, "error": str(e)}

def send_photo(chat_id, photo, caption=None, reply_markup=None, parse_mode="HTML"):
    url = f"{BASE_URL}/sendPhoto"
    payload = {"chat_id": chat_id, "photo": photo, "parse_mode": parse_mode}
    if caption:
        payload["caption"] = caption
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if result.get("ok"):
            logger.info(f"✅ Фото отправлено в {chat_id}")
        else:
            logger.error(f"❌ Ошибка send_photo: {result}")
        return result
    except Exception as e:
        logger.error(f"💥 Ошибка send_photo: {e}")
        logger.error(traceback.format_exc())
        return {"ok": False, "error": str(e)}

def delete_message(chat_id, message_id):
    url = f"{BASE_URL}/deleteMessage"
    payload = {"chat_id": chat_id, "message_id": message_id}
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if result.get("ok"):
            logger.debug(f"✅ Сообщение {message_id} удалено")
        else:
            logger.error(f"❌ Ошибка delete_message: {result}")
        return result
    except Exception as e:
        logger.error(f"💥 Ошибка delete_message: {e}")
        return {"ok": False, "error": str(e)}

def answer_callback(callback_id, text=None, show_alert=False):
    url = f"{BASE_URL}/answerCallbackQuery"
    payload = {"callback_query_id": callback_id}
    if text:
        payload["text"] = text
    if show_alert:
        payload["show_alert"] = True
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if result.get("ok"):
            logger.debug(f"✅ answer_callback {callback_id}")
        else:
            logger.error(f"❌ Ошибка answer_callback: {result}")
        return result
    except Exception as e:
        logger.error(f"💥 Ошибка answer_callback: {e}")
        logger.error(traceback.format_exc())
        return {"ok": False, "error": str(e)}

def get_username(chat_id):
    try:
        url = f"{BASE_URL}/getChat"
        response = requests.post(url, json={"chat_id": chat_id}, timeout=30)
        result = response.json()
        if result.get("ok"):
            user = result.get("result", {})
            username = user.get("username")
            if username:
                return username
            return user.get("first_name", "Пользователь")
        return "Пользователь"
    except Exception as e:
        logger.error(f"💥 Ошибка get_username для {chat_id}: {e}")
        return "Пользователь"

def get_full_name(chat_id):
    try:
        url = f"{BASE_URL}/getChat"
        response = requests.post(url, json={"chat_id": chat_id}, timeout=30)
        result = response.json()
        if result.get("ok"):
            user = result.get("result", {})
            first_name = user.get("first_name", "")
            last_name = user.get("last_name", "")
            if first_name or last_name:
                return f"{first_name} {last_name}".strip()
            return "Пользователь"
        return "Пользователь"
    except:
        return "Пользователь"

