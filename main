UC_PRICES = {
    "60": 83,
    "120": 175,
    "180": 265,
    "240": 360,
    "325": 446,
    "385": 549,
    "445": 625,
    "660": 869,
    "720": 957,
    "985": 1290,
    "1045": 1400,
    "1800": 2119,
    "3850": 4200
}

POP_PRICES = {
    "10000": 176,
    "20000": 307,
    "30000": 439,
    "40000": 578,
    "50000": 715,
    "60000": 857,
    "70000": 989,
    "100000": 1375,
    "150000": 1994,
    "200000": 2612,
    "500000": 6272
}

def get_cart_total(cart, prices):
    total_items = sum(int(k) * v for k, v in cart.items())
    total_price = sum(prices.get(k, 0) * v for k, v in cart.items())
    return total_items, total_price

def get_cart_text(cart, prices, is_pop=False):
    if not cart:
        return f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> Корзина пуста'
    text = ""
    for k, v in cart.items():
        if is_pop:
            formatted = f"{int(k):,}".replace(",", " ")
            text += f"• {formatted} ПП x {v} = {prices.get(k, 0) * v}₽\n"
        else:
            text += f"• {k} UC x {v} = {prices.get(k, 0) * v}₽\n"
    return text

# ========== ОБРАБОТКА ==========

def handle_update(update):
    try:
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}, "last_message_id": None}
            
            logger.info(f"💬 Сообщение от {chat_id}: {text}")
            
            if text == "/start":
                if not is_working_time():
                    if user_data[user_id].get("last_message_id"):
                        delete_message(chat_id, user_data[user_id]["last_message_id"])
                    result = send_message(chat_id, get_closed_message())
                    if result.get("ok"):
                        user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                    return
                
                if user_data[user_id].get("last_message_id"):
                    delete_message(chat_id, user_data[user_id]["last_message_id"])
                
                try:
                    result = send_photo(chat_id, PHOTO_URL, caption=MAIN_MENU_TEXT, reply_markup=main_menu())
                    if result.get("ok"):
                        user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                except:
                    result = send_message(chat_id, MAIN_MENU_TEXT, main_menu())
                    if result.get("ok"):
                        user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if user_data[user_id].get("step") == "waiting_pubg":
                pubg_id = text.strip()
                if not pubg_id.isdigit():
                    send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Неверный формат. Введите только цифры:', after_payment_menu())
                    return
                
                if len(pubg_id) < 3:
                    send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Слишком короткий ID. Введите минимум 3 цифры:', after_payment_menu())
                    return
                
                user_data[user_id]["temp"]["pubg_id"] = pubg_id
                user_data[user_id]["step"] = "main"
                
                order_type = user_data[user_id]["temp"].get("order_type", "UC")
                order_id = user_data[user_id]["temp"].get("order_id")
                
                if order_id and order_id in orders:
                    order = orders[order_id]
                    order["pubg_id"] = pubg_id
                    order["status"] = "pending"
                    
                    username = get_username(chat_id)
                    full_name = get_full_name(chat_id)
                    
                    if order_type == "UC":
                        total = order["total_uc"]
                        price = order["price"]
                        cart_text = get_cart_text(order["cart"], UC_PRICES, False)
                        item_name = f"{total} UC"
                    else:
                        total = order["total_pop"]
                        price = order["price"]
                        cart_text = get_cart_text(order["cart"], POP_PRICES, True)
                        item_name = f"{total} ПП"
                    
                    if user_id not in user_orders:
                        user_orders[user_id] = []
                    user_orders[user_id].append({
                        "id": order_id,
                        "item_name": item_name,
                        "status": "pending",
                        "price": price,
                        "pubg_id": pubg_id,
                        "order_type": order_type,
                        "created_at": datetime.datetime.now().isoformat()
                    })
                    
                    owner_text = (
                        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>НОВЫЙ ЗАКАЗ</b>\n'
                        f'<tg-emoji emoji-id="{EMOJI_GEAR}">⚙️</tg-emoji> <b>Тип:</b> {order_type}\n'
                        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> <b>Покупатель:</b> {full_name}\n'
                        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> <b>Username:</b> @{username}\n'
                        f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> <b>PUBG ID:</b> {pubg_id}\n'
                        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Товары:</b>\n{cart_text}'
                        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>Сумма:</b> {price}₽'
                    )
                    send_message(OWNER_ID, owner_text, owner_done_menu(order_id))
                    
                    if user_data[user_id].get("last_message_id"):
                        delete_message(chat_id, user_data[user_id]["last_message_id"])
                    
                    result = send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>ЗАКАЗ ПОДТВЕРЖДЁН!</b>\n\n'
                        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Товар:</b> {item_name}\n'
                        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>Сумма:</b> {price}₽\n'
                        f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> <b>PUBG ID:</b> {pubg_id}\n'
                        f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> <b>Доставка:</b> 5-30 минут',
                        main_menu()
                    )
                    if result.get("ok"):
                        user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                    
                    if order_type == "UC":
                        user_data[user_id]["uc_cart"] = {}
                    else:
                        user_data[user_id]["pop_cart"] = {}
                return
        
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            data = cb["data"]
            cb_id = cb["id"]
            user_id = str(chat_id)
            
            logger.info(f"🖱 Кнопка нажата: {data} от {chat_id}")
            answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> {data}')
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}, "last_message_id": None}
            
            if user_data[user_id].get("last_message_id"):
                delete_message(chat_id, user_data[user_id]["last_message_id"])
                user_data[user_id]["last_message_id"] = None
            
            # ---- ПРОВЕРКА РАБОЧЕГО ВРЕМЕНИ ----
            if not is_working_time() and not data.startswith(("confirm_payment_", "reject_payment_", "order_done_", "order_cancel_")):
                result = send_message(chat_id, get_closed_message())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            # ---- НАЗАД ----
            if data == "back":
                try:
                    result = send_photo(chat_id, PHOTO_URL, caption=MAIN_MENU_TEXT, reply_markup=main_menu())
                    if result.get("ok"):
                        user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                except:
                    result = send_message(chat_id, MAIN_MENU_TEXT, main_menu())
                    if result.get("ok"):
                        user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            # ---- МОИ ЗАКАЗЫ ----
            if data == "my_orders":
                user_orders_list = user_orders.get(user_id, [])
                if not user_orders_list:
                    result = send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_ORDERS}">📋</tg-emoji> <b>У вас пока нет заказов</b>', main_menu())
                    if result.get("ok"):
                        user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                    return
                
                text = f'<tg-emoji emoji-id="{EMOJI_LIST}">📋</tg-emoji> <b>Ваши заказы:</b>\n\n'
                for order in user_orders_list:
                    if order["status"] == "completed":
                        status_emoji = f'<tg-emoji emoji-id="{EMOJI_COMPLETED}">✅</tg-emoji>'
                    elif order["status"] == "rejected":
                        status_emoji = f'<tg-emoji emoji-id="{EMOJI_REJECTED}">❌</tg-emoji>'
                    else:
                        status_emoji = f'<tg-emoji emoji-id="{EMOJI_PENDING}">⏳</tg-emoji>'
                    
                    created_time = datetime.datetime.fromisoformat(order["created_at"]).strftime("%d.%m.%Y %H:%M")
                    text += f'{status_emoji} <b>{order["item_name"]}</b>\n'
                    text += f'💰 {order["price"]}₽ | 🆔 {order["pubg_id"]}\n'
                    text += f'📅 {created_time}\n\n'
                
                result = send_message(chat_id, text, main_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            # ---- UC ----
            if data == "buy_uc":
                result = send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> <b>КОРЗИНА UC</b>\n\nВыберите количество UC:', uc_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if data.startswith("uc_") and data not in ["uc_checkout", "uc_clear"]:
                amount = data.replace("uc_", "")
                user_data[user_id]["uc_cart"][amount] = user_data[user_id]["uc_cart"].get(amount, 0) + 1
                total, price = get_cart_total(user_data[user_id]["uc_cart"], UC_PRICES)
                cart_text = get_cart_text(user_data[user_id]["uc_cart"], UC_PRICES, False)
                
                result = send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> <b>КОРЗИНА UC</b>\n\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Итого:</b> {total} UC — {price}₽',
                    uc_menu()
                )
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if data == "uc_clear":
                user_data[user_id]["uc_cart"] = {}
                result = send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> <b>КОРЗИНА UC</b>\n\n<tg-emoji emoji-id="{EMOJI_CROSS}">🗑</tg-emoji> <b>Очищена</b>', uc_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if data == "uc_checkout":
                cart = user_data[user_id]["uc_cart"]
                if not cart:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Корзина пуста!', True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "UC"
                total, price = get_cart_total(cart, UC_PRICES)
                cart_text = get_cart_text(cart, UC_PRICES, False)
                
                text = (
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> <b>ОПЛАТА ЗАКАЗА UC</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Товары:</b>\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>Итого:</b> {price}₽\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_GEAR}">⚙️</tg-emoji> <b>Способы оплаты (Сбербанк):</b>\n'
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> <b>Карта:</b> <code>2202208555983213</code>\n'
                    f'<tg-emoji emoji-id="{EMOJI_PHONE}">📱</tg-emoji> <b>Телефон:</b> <code>+7 952 321-66-09</code>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_WARN}">⚠️</tg-emoji> <b>После оплаты нажмите «Я оплатил»</b>'
                )
                result = send_message(chat_id, text, payment_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            # ---- ПОПУЛЯРНОСТЬ ----
            if data == "popularity":
                result = send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_STAR}">⭐️</tg-emoji> <b>КОРЗИНА ПОПУЛЯРНОСТИ</b>\n\nВыберите количество ПП:', popularity_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if data.startswith("pop_") and data not in ["pop_checkout", "pop_clear"]:
                amount = data.replace("pop_", "")
                user_data[user_id]["pop_cart"][amount] = user_data[user_id]["pop_cart"].get(amount, 0) + 1
                total, price = get_cart_total(user_data[user_id]["pop_cart"], POP_PRICES)
                cart_text = get_cart_text(user_data[user_id]["pop_cart"], POP_PRICES, True)
                
                result = send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{EMOJI_STAR}">⭐️</tg-emoji> <b>КОРЗИНА ПОПУЛЯРНОСТИ</b>\n\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Итого:</b> {total} ПП — {price}₽',
                    popularity_menu()
                )
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if data == "pop_clear":
                user_data[user_id]["pop_cart"] = {}
                result = send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_STAR}">⭐️</tg-emoji> <b>КОРЗИНА ПОПУЛЯРНОСТИ</b>\n\n<tg-emoji emoji-id="{EMOJI_CROSS}">🗑</tg-emoji> <b>Очищена</b>', popularity_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if data == "pop_checkout":
                cart = user_data[user_id]["pop_cart"]
                if not cart:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Корзина пуста!', True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "ПП"
                total, price = get_cart_total(cart, POP_PRICES)
                cart_text = get_cart_text(cart, POP_PRICES, True)
                
                text = (
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> <b>ОПЛАТА ЗАКАЗА ПОПУЛЯРНОСТИ</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Товары:</b>\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>Итого:</b> {price}₽\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_GEAR}">⚙️</tg-emoji> <b>Способы оплаты (Сбербанк):</b>\n'
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> <b>Карта:</b> <code>2202208555983213</code>\n'
                    f'<tg-emoji emoji-id="{EMOJI_PHONE}">📱</tg-emoji> <b>Телефон:</b> <code>+7 952 321-66-09</code>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_WARN}">⚠️</tg-emoji> <b>После оплаты нажмите «Я оплатил»</b>'
                )
                result = send_message(chat_id, text, payment_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            # ---- ОПЛАТА ----
            if data == "i_paid":
                order_type = user_data[user_id]["temp"].get("order_type", "UC")
                
                if order_type == "UC":
                    cart = user_data[user_id]["uc_cart"]
                    total_uc, price = get_cart_total(cart, UC_PRICES)
                    cart_text = get_cart_text(cart, UC_PRICES, False)
                    total_pop = 0
                else:
                    cart = user_data[user_id]["pop_cart"]
                    total_pop, price = get_cart_total(cart, POP_PRICES)
                    cart_text = get_cart_text(cart, POP_PRICES, True)
                    total_uc = 0
                
                username = get_username(chat_id)
                full_name = get_full_name(chat_id)
                order_id = f"{chat_id}_{int(time.time())}"
                
                orders[order_id] = {
                    "user_id": chat_id,
                    "cart": cart,
                    "total_uc": total_uc,
                    "total_pop": total_pop,
                    "price": price,
                    "order_type": order_type,
                    "username": username,
                    "full_name": full_name,
                    "status": "waiting_confirmation",
                    "created_at": datetime.datetime.now().isoformat()
                }
                
                user_data[user_id]["temp"]["order_id"] = order_id
                
                owner_text = (
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>ПОДТВЕРЖДЕНИЕ ОПЛАТЫ</b>\n'
                    f'<tg-emoji emoji-id="{EMOJI_GEAR}">⚙️</tg-emoji> <b>Тип:</b> {order_type}\n'
                    f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> <b>Покупатель:</b> {full_name}\n'
                    f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> <b>Username:</b> @{username}\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Товары:</b>\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>Сумма:</b> {price}₽\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_WARN}">❓</tg-emoji> <b>Деньги пришли?</b>'
                )
                send_message(OWNER_ID, owner_text, owner_confirm_menu(order_id))
                
                result = send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> <b>Ожидайте подтверждения оплаты...</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Товар:</b> {order_type}\n'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>Сумма:</b> {price}₽\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_SUPPORT}">🆘</tg-emoji> Мы проверим оплату в ближайшее время.',
                    main_menu()
                )
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if data == "cancel":
                user_data[user_id]["uc_cart"] = {}
                user_data[user_id]["pop_cart"] = {}
                user_data[user_id]["step"] = "main"
                user_data[user_id]["temp"] = {}
                result = send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> <b>Заказ отменён</b>', main_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            # ---- ПОДТВЕРЖДЕНИЕ ОТ ВЛАДЕЛЬЦА ----
            if data.startswith("confirm_payment_"):
                order_id = data.replace("confirm_payment_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ не найден', True)
                    return
                
                user_id = order["user_id"]
                order_type = order.get("order_type", "UC")
                price = order["price"]
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>ОПЛАТА ПОДТВЕРЖДЕНА!</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Товар:</b> {order_type}\n'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>Сумма:</b> {price}₽\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> <b>Введите ваш PUBG ID</b>\n'
                    f'<tg-emoji emoji-id="{EMOJI_WARN}">⚠️</tg-emoji> <i>Только цифры</i>',
                    after_payment_menu()
                )
                
                user_data[str(user_id)]["step"] = "waiting_pubg"
                user_data[str(user_id)]["temp"]["order_id"] = order_id
                user_data[str(user_id)]["temp"]["order_type"] = order_type
                
                answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> Пользователь уведомлён')
                result = send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Пользователь уведомлён.</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> Ожидает ввода PUBG ID',
                    main_menu()
                )
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if data.startswith("reject_payment_"):
                order_id = data.replace("reject_payment_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ не найден', True)
                    return
                
                user_id = order["user_id"]
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> <b>ОПЛАТА НЕ ПОДТВЕРЖДЕНА</b>\n\n'
                    f'К сожалению, мы не получили ваш платёж.\n'
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> <b>Заказ отменён.</b>',
                    main_menu()
                )
                
                user_data[str(user_id)]["uc_cart"] = {}
                user_data[str(user_id)]["pop_cart"] = {}
                user_data[str(user_id)]["step"] = "main"
                user_data[str(user_id)]["temp"] = {}
                
                result = send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> <b>Заказ отменён</b>', main_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            # ---- ВЫПОЛНЕНИЕ ЗАКАЗА ----
            if data.startswith("order_done_"):
                order_id = data.replace("order_done_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ не найден', True)
                    return
                
                user_id = order["user_id"]
                total = order["total_uc"] if order["order_type"] == "UC" else order["total_pop"]
                order_type = order.get("order_type", "UC")
                pubg_id = order.get("pubg_id", "Не указан")
                
                if str(user_id) in user_orders:
                    for user_order in user_orders[str(user_id)]:
                        if user_order["id"] == order_id:
                            user_order["status"] = "completed"
                            break
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{EMOJI_DONE}">🎉</tg-emoji> <b>ВАШ ЗАКАЗ ВЫПОЛНЕН!</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>Товар:</b> {total} {order_type}\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> <b>PUBG ID:</b> {pubg_id}\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji> <b>Спасибо за покупку!</b>',
                    main_menu()
                )
                
                result = send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Заказ {order_id} выполнен!</b>', main_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            if data.startswith("order_cancel_"):
                order_id = data.replace("order_cancel_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ не найден', True)
                    return
                
                user_id = order["user_id"]
                
                if str(user_id) in user_orders:
                    for user_order in user_orders[str(user_id)]:
                        if user_order["id"] == order_id:
                            user_order["status"] = "rejected"
                            break
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> <b>ЗАКАЗ ОТМЕНЁН</b>\n\n'
                    f'К сожалению, ваш заказ был отменён.\n'
                    f'<tg-emoji emoji-id="{EMOJI_SUPPORT}">🆘</tg-emoji> Если у вас есть вопросы, обратитесь к поддержке.',
                    main_menu()
                )
                
                user_data[str(user_id)]["uc_cart"] = {}
                user_data[str(user_id)]["pop_cart"] = {}
                user_data[str(user_id)]["step"] = "main"
                user_data[str(user_id)]["temp"] = {}
                
                result = send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> <b>Заказ {order_id} отменён</b>', main_menu())
                if result.get("ok"):
                    user_data[user_id]["last_message_id"] = result.get("result", {}).get("message_id")
                return
            
            # ---- ИНФОРМАЦИЯ ----
            if data == "info":
                text = (
